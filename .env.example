# Where the reader suggestion form sends notes.
# Leave this blank until you have one. The form will say so, and it will not pretend to send anything.
# A Formspree address looks like: https://formspree.io/f/xxxxxxxx
PUBLIC_FEEDBACK_ENDPOINT=

# Your real site address, once you have one. Used for the canonical link and social tags.
# Example: https://jankfield.com
PUBLIC_SITE_URL=
