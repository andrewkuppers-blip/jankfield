---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="That page is not on Jankfield.">
  <section class="page">
    <div class="wrap prose">
      <p class="kicker">404</p>
      <h1>This card is not in the deck.</h1>
      <p>The page you wanted is not here. The home page still has this week's deck.</p>
      <p><a class="button" href="/">Back to Jankfield</a></p>
    </div>
  </section>
</Base>
