---
const { current = '/' } = Astro.props;
const links = [
  { href: '/', label: 'Home' },
  { href: '/posts/', label: 'Archive' },
  { href: '/about/', label: 'About' },
];
---

<a class="skip" href="#main">Skip to content</a>
<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/">
      <svg class="brand-mark" viewBox="0 0 64 64" aria-hidden="true">
        <rect width="64" height="64" rx="12" fill="currentColor"></rect>
        <path d="M12 40c6-1 10-8 16-16 1 7 7 14 16 16" fill="none" stroke="#e2b15a" stroke-width="3.5" stroke-linecap="round"></path>
        <circle cx="24" cy="22" r="3.2" fill="#fff8ec"></circle>
        <circle cx="34" cy="18" r="3.2" fill="#fff8ec"></circle>
        <path d="M18 48h28" stroke="#fff8ec" stroke-width="2.5" stroke-linecap="round"></path>
      </svg>
      <span class="brand-name">Jankfield</span>
    </a>
    <nav class="site-nav" aria-label="Primary">
      {
        links.map((link) => (
          <a href={link.href} aria-current={current === link.href ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
